# Learn Pace local model configuration (copy to .env and fill your credentials)
# 首期默认模型：DeepSeek Flash（OpenAI-completions 兼容接口，支持 streaming / tool calling / JSON）
PI_OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
PI_MODEL=openai/deepseek-v4.1-flash
PI_OPENAI_API=openai-completions
PI_REASONING=high
OPENAI_API_KEY=replace-with-your-api-key
PI_CONTEXT_WINDOW=1048576
PI_MAX_TOKENS=393216
