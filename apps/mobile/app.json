{
  "expo": {
    "name": "Learn Pace",
    "slug": "learn-pace",
    "scheme": "learnpace",
    "version": "0.1.0",
    "orientation": "portrait",
    "jsEngine": "hermes",
    "android": {
      "package": "app.learnpace.m1"
